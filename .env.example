# Generate random tokens yourself; these placeholders are deliberately rejected.
# JSON map: API token -> namespace. Namespace comes from auth, not from job JSON.
P2V_API_KEYS={"replace-with-your-random-token-at-least-24-characters":"demo"}
P2V_WORKERS=2
P2V_PER_NAMESPACE=1
P2V_FFMPEG_THREADS=2
P2V_STAGE_TIMEOUT=180
P2V_JOB_TIMEOUT=1800
